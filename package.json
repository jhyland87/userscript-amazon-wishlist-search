{
  "name": "userscript-amazon-wishlist-search",
  "version": "0.6.0",
  "description": "Adds a search input to the Amazon 'Add to List' wishlist popover",
  "author": "Justin Hyland",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release": "CHECK_GITHUB_RELEASE=1 vitest run release"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.0.5"
  }
}
